{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico",
      "status": 204
    },
    {
      "src": "/(.*)",
      "dest": "app.py",
      "headers": {
        "Access-Control-Allow-Origin": "https://nat-lytics-dashboard.vercel.app",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization",
        "Access-Control-Allow-Credentials": "false"
      }
    }
  ]
}
